# Copy to .env and fill in. NEVER commit .env.
# The backend reads this on startup (python-dotenv).

# --- Vision + live voice: Gemini on Vertex AI ---
# Auth is ADC (Application Default Credentials) — run `gcloud auth application-default login`.
# No API key lives in code.
VISION_PROVIDER=gemini
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash          # Stage A/C still-frame vision (OCR + detection)
GEMINI_LIVE_MODEL=gemini-3.8-live      # live voice directing agent (audio)

# Live recognition during the sweep (fills the on-screen inventory + spoken narration).
# off = cheaper, voice-directing only.
GEMINI_LIVE_VISION=on
LIVE_VISION_INTERVAL_S=3.0             # min seconds between live vision calls
LIVE_NARRATION_GAP_S=7.0               # min seconds between unprompted spoken cues

# --- Book identification metadata (optional) ---
GOOGLE_BOOKS_API_KEY=                  # optional; OpenLibrary needs no key

# --- Pricing: Amazon via a deployed GCP Cloud Function (India egress IP) ---
# The function fetches a local-marketplace Amazon results page and returns HTML.
# See cloud/amazon_fetch/ for the deployable source.
CLOUD_FETCH_URL=https://<region>-<project>.cloudfunctions.net/amazon-fetch-in
CLOUD_FETCH_SECRET=shared-secret-matching-the-function
CLOUD_FETCH_RETRIES=4
CLOUD_FETCH_TIMEOUT=40
# Fallback path (local curl_cffi + datacenter/residential proxy) if CLOUD_FETCH_URL is unset:
PROXY_URL=                             # e.g. http://user:pass@gateway:port
GC_SCRAPING_REPO=/Users/you/Desktop/scraping   # optional: reuse an existing proxy manager
PRICE_WORKERS=8                        # concurrent pricing threads

# --- Used-book value: AbeBooks (the used/second-hand book marketplace) ---
# Localized per country (US/GB/DE/FR/IT); other countries price on abebooks.com and convert.
ABE_RETRIES=3
# Currency conversion for cross-market pricing (brief: label "converted"). FX_LIVE=1 uses a
# free no-key endpoint; unset uses a built-in static table (offline, deterministic).
FX_LIVE=

# --- Capture / measurement ---
FIDUCIAL_MARKER_CM=15.0                # printed ArUco marker edge length (scale anchor)
FIDUCIAL_DICT=DICT_4X4_50              # ArUco dictionary

# --- Pipeline tuning (sensible defaults; override only if needed) ---
BOOK_CONFIDENCE_FLOOR=0.45             # below this a spine is "unidentified", never guessed
APPRAISAL_THRESHOLD=                   # local-currency value above which items need human appraisal
DEDUP_SIMILARITY=0.84                  # fuzzy title/label dedup threshold
STAGE_A_MAX_FRAMES=8                   # frames sampled for spine ID
STAGE_C_MAX_FRAMES=8                   # frames sampled for non-book detection

# --- Backend ---
DATA_DIR=./data/sweeps
