# Copy to .env and fill in. NEVER commit .env.

# --- Live agent (voice) ---
OPENAI_API_KEY=sk-...                 # OpenAI Realtime (live directing agent) + vision

# --- Book identification metadata ---
GOOGLE_BOOKS_API_KEY=                 # optional; OpenLibrary needs no key

# --- Pricing (reuses the scraping repo; wired in Stage D) ---
# Path to the existing scraping framework for proxy/anti-bot reuse.
SCRAPING_REPO_PATH=/Users/muskan/Desktop/scraping
# Currency conversion for the "converted" price path.
FX_API_KEY=

# --- Capture / measurement ---
# Printed fiducial marker edge length in centimetres (default scale anchor).
FIDUCIAL_MARKER_CM=15.0
# ArUco dictionary name, e.g. DICT_4X4_50
FIDUCIAL_DICT=DICT_4X4_50

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATA_DIR=./data/sweeps

# Live recognition during the sweep (fills inventory live). off = cheaper, voice-only directing.
GEMINI_LIVE_VISION=on
LIVE_VISION_INTERVAL_S=3.0
